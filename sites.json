{
  "sites": [
    {
      "name": "W3Schools HTML5 Video (test)",
      "baseUrl": "https://www.w3schools.com/html/html5_video.asp",
      "enabled": true,
      "iconUrl": "https://www.google.com/s2/favicons?domain=w3schools.com&sz=%size%",
      "searchUrl": null,
      "resultSelector": "a[href]",
      "linkSelector": "a[href]",
      "titleSelector": "h1",
      "posterSelector": null,
      "descriptionSelector": "body",
      "mediaSelector": "video source, video, source, iframe",
      "proxy": null
    },
    {
      "name": "Yandex Video",
      "baseUrl": "https://yandex.com/video",
      "enabled": true,
      "iconUrl": "https://www.google.com/s2/favicons?domain=yandex.com&sz=%size%",
      "searchUrl": "https://yandex.com/video/search?text={query}",
      "resultSelector": "a[href*='/video/preview/'], a[href*='/video/'], a[href*='yandex.com/video/preview/']",
      "linkSelector": "a[href*='/video/preview/'], a[href*='/video/']",
      "titleSelector": "h1",
      "posterSelector": "img[src]",
      "descriptionSelector": "body",
      "mediaSelector": "video source, video, source, iframe, meta[property='og:video'], meta[property='og:video:url']",
      "proxy": null
    },
    {
      "name": "Dailymotion",
      "baseUrl": "https://www.dailymotion.com",
      "enabled": true,
      "iconUrl": "https://www.google.com/s2/favicons?domain=dailymotion.com&sz=%size%",
      "searchUrl": "https://www.dailymotion.com/search/{query}",
      "resultSelector": "a[href*='/video/']",
      "linkSelector": "a[href*='/video/']",
      "titleSelector": "h1",
      "posterSelector": "meta[property='og:image']",
      "descriptionSelector": "meta[property='og:description']",
      "mediaSelector": "video source, video, source, iframe, meta[property='og:video'], meta[property='og:video:url']",
      "proxy": null
    },
    {
      "name": "Vimeo",
      "baseUrl": "https://vimeo.com",
      "enabled": true,
      "iconUrl": "https://www.google.com/s2/favicons?domain=vimeo.com&sz=%size%",
      "searchUrl": "https://vimeo.com/search?q={query}",
      "resultSelector": "a[href*='vimeo.com/']",
      "linkSelector": "a[href*='vimeo.com/']",
      "titleSelector": "h1",
      "posterSelector": "meta[property='og:image']",
      "descriptionSelector": "meta[property='og:description']",
      "mediaSelector": "video source, video, source, iframe, meta[property='og:video'], meta[property='og:video:url']",
      "proxy": null
    },
    {
      "name": "Twitch",
      "baseUrl": "https://www.twitch.tv",
      "enabled": true,
      "iconUrl": "https://www.google.com/s2/favicons?domain=twitch.tv&sz=%size%",
      "searchUrl": null,
      "resultSelector": "a[href]",
      "linkSelector": "a[href]",
      "titleSelector": "h1",
      "posterSelector": "meta[property='og:image']",
      "descriptionSelector": "meta[property='og:description']",
      "mediaSelector": "video source, video, source, iframe",
      "proxy": null
    }
  ],
  "proxies": [
    {
      "name": "My Authorized Proxy",
      "template": "https://your-proxy.example/?url={url}",
      "enabled": false
    }
  ]
}
